---
import BaseLayout from "../components/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import OfferCard from "../components/OfferCard.astro";
import BuilderSteps from "../components/BuilderSteps.astro";
import ActionBand from "../components/ActionBand.astro";
import offersJson from "../../data/featured-offers.json";

const descriptions = {
  "Rolling Rock": "Posted beer offer at Harrison Liquor in Lincoln Park. Alcohol requires valid ID.",
  "Busch": "Posted beer offer at Harrison Liquor in Lincoln Park. Alcohol requires valid ID.",
  "Better Made": "Snack offer for a quick grocery, drink or convenience stop.",
  "Monster": "Energy drink offer near Lincoln Park. Call to confirm sizes and flavors.",
  "Monster 24 fl oz": "Sale-list wording. Call to confirm exact register details.",
  "Red Bull": "Posted Red Bull offer near Lincoln Park."
};

const offers = offersJson.map((offer) => ({ ...offer, description: descriptions[offer.name] }));
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "Harrison Liquor Featured Store Offers",
    url: "https://harrisonliquorwinemarket.vercel.app/featured-offers.html",
    itemListElement: offers.map((offer) => ({
      "@type": "Offer",
      name: offer.headline,
      priceCurrency: "USD",
      availability: "https://schema.org/InStoreOnly"
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Are Harrison Liquor offers live inventory?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. The offer page is based on the current posted store sale list. Prices, sizes and availability may change, so customers should call Harrison Liquor & Wine Market before making a special trip."
        }
      },
      {
        "@type": "Question",
        name: "Where is Harrison Liquor & Wine Market located?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Harrison Liquor & Wine Market is located at 735 Harrison Blvd, Lincoln Park, MI 48146."
        }
      }
    ]
  }
];

const steps = [
  { title: "Pick the offer", copy: "Start with the beer, snack or energy drink item you came for." },
  { title: "Add the stop", copy: "Ask about mixers, candy, chips, grocery basics, tobacco, vape or accessories if needed." },
  { title: "Confirm today", copy: "Call Harrison Liquor for current prices, sizes, flavors and availability before visiting." }
];
---
<BaseLayout title="Weekly Store Offers in Lincoln Park, MI | Harrison Liquor" description="View weekly posted offers at Harrison Liquor in Lincoln Park, MI including beer, snacks, Monster, Red Bull and mix and match store stop ideas." canonical="https://harrisonliquorwinemarket.vercel.app/featured-offers.html" schema={schema}>
  <SimpleHeader secondaryHref="/mix-and-match.html" secondaryLabel="Mix & Match" />
  <main>
    <section class="page-hero offers-hero">
      <div>
        <p class="eyebrow">Weekly posted offers</p>
        <h1>Current offers for fast shopping.</h1>
        <p>Use this page to plan a quick Harrison Liquor stop near Lincoln Park. Offers are based on the current posted store sale list, then organized by beer, snacks, energy drinks and mix-and-match needs.</p>
        <div class="hero-actions">
          <a class="button primary" href="tel:+13133893759">Call Store</a>
          <a class="button secondary" href="https://www.google.com/maps/search/?api=1&query=735%20Harrison%20Blvd%2C%20Lincoln%20Park%2C%20MI%2048146" target="_blank" rel="noopener">Directions</a>
          <a class="button ghost" href="/mix-and-match.html">Build a stop</a>
        </div>
      </div>
      <aside class="offer-summary-card" aria-label="Offer page summary">
        <img src="/assets/photos/final-webp/real-wide-store-polished-1200.webp" width="1200" height="900" decoding="async" alt="Wide interior view of Harrison Liquor & Wine Market in Lincoln Park" />
        <span>Offer board</span>
        <strong>Beer, snacks and energy drinks</strong>
        <p>735 Harrison Blvd, Lincoln Park, MI 48146</p>
        <small>Call before visiting. Prices and availability may change.</small>
      </aside>
    </section>

    <section class="offer-board section-pad" aria-labelledby="offer-board-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Offer board</p>
          <h2 id="offer-board-title">Posted deals customers can scan in seconds.</h2>
        </div>
        <p>Each card has one clear product, price and next action. Unverified sale-list items stay off the public board until the product name is confirmed.</p>
      </div>
      <div class="offer-photo-rail" aria-label="Real Harrison Liquor store photos">
        <figure>
          <img src="/assets/photos/final-webp/grocery-drinks-addons-basket-900.webp" width="900" height="506" loading="lazy" decoding="async" alt="Basket with drinks and snacks inside Harrison Liquor" />
          <figcaption>Quick drink and snack stop</figcaption>
        </figure>
        <figure>
          <img src="/assets/photos/final-webp/counter-wall-store-context-1200.webp" width="1200" height="720" loading="lazy" decoding="async" alt="Counter shelves and product wall inside Harrison Liquor & Wine Market" />
          <figcaption>Counter and shelf selection</figcaption>
        </figure>
        <figure>
          <img src="/assets/photos/final-webp/canned-drinks-crop-safe-615.webp" width="615" height="900" loading="lazy" decoding="async" alt="Canned drinks display used as store drink context" />
          <figcaption>Cold drink add-ons</figcaption>
        </figure>
      </div>
      <div class="posted-offer-grid">
        {offers.map((offer, index) => <OfferCard offer={offer} className={index < 4 ? "featured-sale" : ""} label={offer.category === "Energy drinks" ? "Energy drink offer" : `${offer.category} offer`} />)}
        <article class="sale-offer-card primary-offer">
          <img src="/assets/photos/final-webp/tequila-counter-drinks-900.webp" width="900" height="506" loading="lazy" decoding="async" alt="Counter drink setup at Harrison Liquor used for mix and match shopping context" />
          <span>Mix and match</span>
          <h2>Build one store stop</h2>
          <strong>Call for today</strong>
          <p>Pair offers with snacks, mixers, tobacco, vape and convenience items.</p>
          <a class="text-link" href="/mix-and-match.html">Build a stop</a>
        </article>
      </div>
    </section>

    <section class="weather-stop section-pad" data-weather-stop data-api-status="loading" aria-labelledby="weather-stop-title">
      <div>
        <p class="eyebrow">Smart local cue</p>
        <h2 id="weather-stop-title" data-weather-title>Plan around today</h2>
      </div>
      <div>
        <p data-weather-copy>Checking local Lincoln Park weather for a useful shopping prompt. The offers page still works if live weather is unavailable.</p>
        <small data-weather-meta>Weather is optional. Call the store for exact prices and availability.</small>
      </div>
    </section>

    <section class="offer-playbook section-pad" aria-labelledby="playbook-title">
      <div>
        <p class="eyebrow">How to shop it</p>
        <h2 id="playbook-title">A better way to use the offer page.</h2>
      </div>
      <BuilderSteps steps={steps} />
    </section>

    <ActionBand />
    <section class="age-note section-pad"><strong>Offer notice</strong><p>Featured offers may change without notice. The website does not guarantee live inventory or pricing. Call the store for current information.</p></section>
  </main>
  <script src="/api-enhancements.js" defer></script>
</BaseLayout>
